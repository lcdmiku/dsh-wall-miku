{
    "name": "dsh-skin-miku",
    "version": "0.1.0",
    "description": "skin of DeepseekHarness",
    "type": "module",
    "main": "index.mjs",
    "license": "MIT",
    "keywords": [
        "deepseek",
        "harness",
        "dsh",
        "dsh-plugin",
        "theme",
        "skin"
    ],
    "exports": {
        ".": "./index.mjs",
        "./client": "./client/client.js",
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json"
    },
    "files": [
        "index.mjs",
        "client/client.js",
        "assets",
        "cordis.patch.yml",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "esbuild client/src/index.js --bundle --format=iife --external:react --outfile=client/client.js",
        "test": "node --test --experimental-test-isolation=none",
        "prepublishOnly": "npm run build"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-theme"
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lcdmiku/dsh-wall-miku.git"
    },
    "author": "akalin",
    "engines": {
        "node": ">=22"
    },
    "bugs": {
        "url": "https://github.com/lcdmiku/dsh-wall-miku/issues"
    },
    "homepage": "https://github.com/lcdmiku/dsh-wall-miku#README",
    "devDependencies": {
        "@types/node": "^26.5.1",
        "esbuild": "^0.28.2",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^29.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
